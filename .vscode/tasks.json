{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (FastAPI)",
      "type": "shell",
      "command": ".\\backend\\venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "env": {
          "PYTHONPATH": "backend"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Frontend (Vite)",
      "type": "shell",
      "command": "npm.cmd run dev -- --host 127.0.0.1 --port 3000",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
