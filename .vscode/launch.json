{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "backend"
      }
    },
    {
      "name": "Frontend: Vite React",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev -- --host 127.0.0.1 --port 3000",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend",
      "configurations": ["Backend: FastAPI (Uvicorn)", "Frontend: Vite React"]
    }
  ]
}
