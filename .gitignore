# ==========================================
# Accurate AI - Production .gitignore
# ==========================================

# Environment & Sensitive Credentials (NEVER COMMIT)
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Local Data, Uploaded User Documents & Databases (CRITICAL: NEVER COMMIT PERSONAL DATA)
data/
backend/data/
*.db
*.db-journal
*.sqlite
*.sqlite3
!data/uploads/.gitkeep
!data/chroma/.gitkeep

# User Personal Documents / Binary files in root
*.pptx
*.ppt
*.docx
*.xlsx
*.xls
*.pdf

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
ENV/
env/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Caching & Model Weights (FastEmbed / HuggingFace)
.cache/
fastembed_cache/
.fastembed/
.fastembed_cache/
tmp/
temp/
*.log

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/
frontend/.env*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Specific Files
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.project
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
